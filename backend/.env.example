# Copy to backend/.env (gitignored). Never commit real keys.
# build.nvidia.com key — enables hosted nvidia/cosmos-reason2-8b + NVIDIA retrieval embeddings
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
COSMOS_REASON_MODEL=nvidia/cosmos-reason2-8b
# Workshop endpoints (from the VAST/VSS VM), if available — override the hosted ones
COSMOS_REASON_BASE=
COSMOS_EMBED_BASE=
COSMOS_EMBED_MODEL=
LLM_MODEL=nvidia/cosmos-reason2-8b
VAST_ENDPOINT=
# Workshop token: value, or a command printing it (kept in memory only)
COSMOS_API_KEY=
COSMOS_TOKEN_CMD=
